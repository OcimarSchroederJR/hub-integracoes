{
  "title": "Hub de Integrações",
  "uid": "hub-integracoes",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Profundidade de fila",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hub_fila_profundidade",
          "legendFormat": "{{fila}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Registros processados por parceiro e resultado (taxa/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (parceiro, resultado) (rate(hub_registros_processados_total[5m]))",
          "legendFormat": "{{parceiro}} - {{resultado}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duração de chamada externa, p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, parceiro) (rate(hub_chamada_externa_duracao_ms_bucket[5m])))",
          "legendFormat": "{{parceiro}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fila de mortos",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hub_dead_letter_total",
          "legendFormat": "{{fila}}",
          "refId": "A"
        }
      ]
    }
  ]
}
