APP_PORT=3000
# Se a maquina ja tiver MySQL/Redis ocupando as portas padrao, suba o compose com
# MYSQL_HOST_PORT=3307 REDIS_HOST_PORT=6380 docker compose up -d e ajuste as duas linhas abaixo.
DATABASE_URL=mysql://hub:hub@localhost:3306/hub
REDIS_HOST=localhost
REDIS_PORT=6379
PARCEIRO_ALFA_BASE_URL=http://localhost:4000
PARCEIRO_ALFA_TOKEN=token-de-desenvolvimento
PARCEIRO_ALFA_RATE_LIMIT_POR_MINUTO=60
PARCEIRO_BETA_CSV_URL=http://localhost:4000/beta/carteira.csv
PARCEIRO_BETA_WEBHOOK_URL=http://localhost:4000/beta/webhook
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
S3_BUCKET_RAW=hub-raw-payloads
FILA_CONCORRENCIA_NORMALIZACAO=10
FILA_TENTATIVAS_MAXIMAS=5
LOG_LEVEL=info
